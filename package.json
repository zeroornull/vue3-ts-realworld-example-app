{
  "name": "vue3-ts-realworld-example-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run --bun vue-tsc -b && bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "type-check": "bun run --bun vue-tsc -b",
    "test": "bun test",
    "test:e2e": "bunx playwright test",
    "test:e2e:security": "bunx playwright test --grep @security",
    "test:e2e:official:list": "bunx playwright test --config playwright.official.config.ts --list",
    "test:e2e:official:security:preflight": "bun run --bun scripts/official-security-preflight.ts",
    "format": "bun run --bun prettier . --write",
    "format:check": "bun run --bun prettier . --check",
    "lint": "bun run --bun oxlint . && bun run --bun eslint .",
    "lint:fix": "bun run format && bun run --bun oxlint --fix . && bun run --bun eslint . --fix",
    "lint:oxlint": "bun run --bun oxlint .",
    "lint:eslint": "bun run --bun eslint .",
    "lint:eslint:fix": "bun run --bun eslint . --fix",
    "check": "bun run format:check && bun run lint && bun run type-check"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "pinia": "^4.0.3",
    "vue": "3.6.0-rc.3",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsonc": "3.4.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.78.0",
    "prettier": "3.9.6",
    "sass": "^1.102.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
